# Copiar a .env y ajustar. Todas las variables usan prefijo BETO_.
# Con BETO_ENTORNO=produccion el backend se niega a arrancar si
# BETO_JWT_SECRET conserva el valor de prototipo o tiene menos de 32
# caracteres (ver app/config.py).
BETO_ENTORNO=desarrollo
BETO_DATABASE_URL=sqlite:///./prototipo.db
# Producción: BETO_DATABASE_URL=postgresql+psycopg://beto:beto@postgres:5432/beto
BETO_JWT_SECRET=generar-un-secreto-largo-y-aleatorio
BETO_JWT_EXPIRACION_MINUTOS=60
BETO_ML_SERVICE_URL=http://ml-service:8001
BETO_ML_TIMEOUT_SEGUNDOS=10
